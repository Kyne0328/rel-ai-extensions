{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kyne0328/rel-ai-extensions/main/schema/relai-extension.schema.json",
  "title": "Rel.AI Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "kind",
    "compatibility",
    "publisher",
    "repository",
    "permissions",
    "requires",
    "entrypoints",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "kind": {
      "enum": [
        "skill",
        "cli"
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relai"
      ],
      "properties": {
        "relai": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "workspace.read",
          "workspace.write",
          "command.execute",
          "git",
          "network",
          "browser",
          "computer"
        ]
      },
      "maxItems": 7
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "platforms"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._+-]{1,100}$"
          }
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {
            "enum": [
              "win32",
              "darwin",
              "linux"
            ]
          }
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill"
      ],
      "properties": {
        "skill": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "command": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+-]{1,100}$"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "artifacts"
      ],
      "properties": {
        "type": {
          "const": "binary"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "arch",
              "url",
              "sha256"
            ],
            "properties": {
              "platform": {
                "enum": [
                  "win32",
                  "darwin",
                  "linux"
                ]
              },
              "arch": {
                "enum": [
                  "x64",
                  "arm64"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
